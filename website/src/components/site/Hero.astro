---
import { Icon } from "astro-icon/components";
const authors = [
  "Abhijeet Gupta",
  "Shruti Singh",
  "Vijayan Asari",
  "Tam V. Nguyen",
];
const bibtex = `@article{gupta_grove,
  title  = {GROVE: Grounded Violation Evaluator for Visual Inspection},
  author = {Gupta, Abhijeet and Singh, Shruti and Asari, Vijayan and Nguyen, Tam V.},
  note   = {Under review}
}`;
---

<header class="research-hero not-prose full-bleed">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="eyebrow hero-enter">
      <span class="status-dot" aria-hidden="true"></span> UNIVERSITY OF DAYTON <span
        class="eyebrow-divider">/</span
      > CONSTRUCTION SAFETY RESEARCH
    </p>
    <h1 class="hero-enter">GROVE<span class="hero-period">.</span></h1>
    <p class="hero-subtitle hero-enter">
      Grounded Violation Evaluator<br class="sm:hidden" /> for Visual Inspection
    </p>
    <p class="hero-description hero-enter">
      From a safety alert to the <em>visible evidence.</em><br />A local
      vision–language pipeline that scores hazards in construction photographs
      and shows where to look.
    </p>
    <div class="hero-actions hero-enter">
      <a class="action-primary" href="#teaser"
        >Explore GROVE <Icon name="ri:arrow-down-line" size={18} /></a
      >
      <a
        class="action-secondary"
        href="https://github.com/abhijeetgupta02/GROVE"
        ><Icon name="ri:github-line" size={18} /> Code &amp; results <span
          aria-hidden="true">↗</span
        ></a
      >
      <a class="action-secondary" href="https://doi.org/10.5281/zenodo.24145023"
        ><Icon name="ri:archive-line" size={18} /> Archive <span
          aria-hidden="true">↗</span
        ></a
      >
    </div>
    <div class="hero-byline hero-enter">
      <p>
        {
          authors.map((a, k) => (
            <>
              <span>{a}</span>
              {k < authors.length - 1 ? (
                <span class="author-separator" aria-hidden="true">
                  {" "}
                  ·{" "}
                </span>
              ) : null}
            </>
          ))
        }
      </p>
      <div>
        <span>Paper under review</span><span aria-hidden="true">·</span><button
          type="button"
          data-copy-bibtex
          >Copy BibTeX <Icon name="ri:file-copy-line" size={13} /></button
        ><span id="bibtex-status" class="sr-only" aria-live="polite"></span>
      </div>
    </div>
  </div>
  <template id="bibtex-text">{bibtex}</template>
</header>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-bibtex]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const text =
          (document.getElementById("bibtex-text") as HTMLTemplateElement | null)
            ?.content.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text.trim());
          const status = document.getElementById("bibtex-status");
          if (status) status.textContent = "BibTeX copied to the clipboard";
          button.textContent = "Copied ✓";
        } catch {
          location.hash = "#bibtex";
        }
      });
    });
</script>
