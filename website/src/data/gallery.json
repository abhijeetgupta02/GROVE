{
 "set": "development",
 "n_images_in_set": 203,
 "seed": null,
 "selection_rule": "Author-selected examples from our Gemini-generated development images, showing Fall and protective equipment only. Ten illustrate correct identification and, where an alert is raised, a top evidence box at IoU ≥ 0.5. Three show limitations: two false Fall alerts and one correctly identified Fall hazard with imprecise grounding. Development thresholds (Fall 0.12, PPE 0.50) were fit on these same 203 images. These are in-sample illustrations, not a representative test; Electrical is not illustrated. Final-set performance is reported separately in Results.",
 "candidates_successes": 10,
 "success_draw_log": [],
 "quotas": {},
 "failure_types": [
  "false Fall alert",
  "grounding overlap below 0.5"
 ],
 "teaser": "191",
 "thresholds_refit": {
  "fall": 0.86,
  "ppe": 0.8
 },
 "thresholds_first_freeze": {
  "fall": 0.12,
  "ppe": 0.5
 },
 "questions": {
  "Fall_Hazard": "Is a worker exposed to falling into an unguarded trench/opening or from an elevated edge, roof, ladder, or scaffold that lacks guardrails or a tied-off harness?",
  "f_fall_edge": "Is there an unprotected elevated edge, incomplete scaffold, or unsafe ladder with a worker at risk of falling?",
  "f_fall_opening": "Is there an unbarricaded floor opening, roof opening, deep trench, or steep excavation edge that someone could fall into?",
  "ok_fall_protected": "Are all elevated edges and openings protected by intact guardrails, barriers, or tied-off fall-arrest harnesses (or are there no elevated edges or trenches)?",
  "Electrocution_Hazard": "Is there an unprotected electrical hazard, such as damaged or exposed live wiring, makeshift power hookups, or work dangerously close to overhead power lines?",
  "f_elec_wire": "Are exposed, hanging, frayed, or makeshift electrical wires, cables, or open junction boxes left unprotected in the work area?",
  "f_elec_lines": "Are workers, ladders, scaffolds, or cranes operating dangerously close to overhead energized power lines?",
  "ok_elec_testing": "Is the only visible electrical equipment a panel being actively inspected or tested by a technician wearing protective gear (gloves, helmet, or face shield)?",
  "PPE_Violation": "Is a visible construction worker missing a required hard hat, high-visibility vest, eye protection, or task-specific protective gear (excluding fall harnesses)?",
  "f_worker": "Is at least one person or worker visible in the image?",
  "f_ppe_nohat": "Is a visible worker in a construction zone not wearing a hard hat or helmet?",
  "f_ppe_novest": "Is a visible worker in a construction zone not wearing a high-visibility vest or reflective jacket?",
  "f_ppe_noeye_glove": "Is a visible worker operating a power tool, welding, cutting, or handling hazardous materials without eye/face protection or gloves?",
  "Housekeeping_Storage": "Is there a slip, trip, or housekeeping violation, such as debris scattered on floors, cords/materials blocking walkways, wet/muddy walking surfaces, or unstable stacked materials?",
  "f_house_trip": "Slip and Trip Hazard: are cords, hoses, pipes, tools, or loose materials obstructing a walking surface, stair, or passageway?",
  "f_house_debris": "Housekeeping and Storage: is scrap, trash, rubble, or unstable/leaning stacked material scattered disorganized across the work area?"
 },
 "state": "Photograph of a construction or industrial site. Judge only visible physical conditions. Safety equipment (guardrails, harnesses, hard hats, vests, barriers) and normal tools in safe use are NOT violations.",
 "formula": {
  "fall": "Fall = 0.5*(Fall_Hazard + max(f_fall_edge, f_fall_opening)) * (1 - 0.35*ok_fall_protected)",
  "ppe": "PPE = 0.5*(PPE_Violation + f_worker*max(f_ppe_nohat, f_ppe_novest, f_ppe_noeye_glove))"
 },
 "weights": {
  "fall_protection": 0.35,
  "electrical_testing": 0.4,
  "fall_mix": 0.5,
  "ppe_mix": 0.5
 },
 "weights_source": "freeze/freeze_2.json (weights)",
 "caption_source": null,
 "dataset_citation": "@misc{chen2025largepretrainedvisionlanguage,\n  title        = {Are Large Pre-trained Vision Language Models Effective Construction Safety Inspectors?}, \n  author       = {Xuezheng Chen and Zhengbo Zou},\n  year         = {2025},\n  eprint       = {2508.11011},\n  archivePrefix= {arXiv},\n  primaryClass = {cs.CV},\n  url          = {https://arxiv.org/abs/2508.11011},\n}",
 "box_note": "Boxes are stored as fractions of the image width and height. gemma4:31b boxes are drawn as written, read as pixel coordinates (the frozen rule).",
 "sources": {
  "scores": "runs/e12/d3_27b__h.jsonl (GROVE), runs/e11/d3_27b__m.jsonl (main questions), runs/e09/gemma4_31b__sp.jsonl (gemma4:31b)",
  "boxes": "results/e31_38.json -> items.31 fixed phrases (new examples); results/gcache_gdino.jsonl (original examples)",
  "labels": "packet/data/grove203/annotations.coco.json",
  "images": "the generated development images (Google Gemini), at most 1600 px on the long side, WebP and JPEG, no metadata"
 },
